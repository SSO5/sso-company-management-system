# ---- Database (PostgreSQL, Vercel-compatible: Neon, Supabase, Vercel Postgres, RDS, etc.) ----
DATABASE_URL="postgresql://user:password@host:5432/sso_cms?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
SESSION_COOKIE_NAME="sso_cms_session"
SESSION_MAX_AGE_HOURS="12"

# ---- File Storage ----
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./private-storage"

# Required only when STORAGE_DRIVER=s3 — mandatory before deploying to Vercel
# (or any serverless host), since local disk storage does not persist there.
#
# Cloudflare R2 setup (recommended — free egress, generous free tier):
#   1. Cloudflare dashboard -> R2 -> Create bucket (e.g. "sso-cms-files")
#   2. R2 -> Manage API Tokens -> Create API Token (Object Read & Write, scoped to that bucket)
#   3. Fill in below: S3_ENDPOINT = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#      (Account ID is shown on the R2 overview page), S3_REGION = "auto"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ---- App ----
NEXT_PUBLIC_APP_NAME="SSO Company Management System"
APP_BASE_URL="http://localhost:3000"

# ---- Notifications (not yet wired to a provider; see lib/notifications) ----
# Configure when ready to enable outbound email/WhatsApp notifications.
EMAIL_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""
