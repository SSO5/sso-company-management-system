# ---- Database (PostgreSQL, Vercel-compatible: Neon, Supabase, Vercel Postgres, RDS, etc.) ----
DATABASE_URL="postgresql://user:password@host:5432/sso_cms?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
SESSION_COOKIE_NAME="sso_cms_session"
SESSION_MAX_AGE_HOURS="12"

# ---- File Storage ----
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./private-storage"

# Required only when STORAGE_DRIVER=s3 — mandatory before deploying to Vercel
# (or any serverless host), since local disk storage does not persist there.
#
# Cloudflare R2 setup (recommended — free egress, generous free tier):
#   1. Cloudflare dashboard -> R2 -> Create bucket (e.g. "sso-cms-files")
#   2. R2 -> Manage API Tokens -> Create API Token (Object Read & Write, scoped to that bucket)
#   3. Fill in below: S3_ENDPOINT = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#      (Account ID is shown on the R2 overview page), S3_REGION = "auto"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ---- App ----
NEXT_PUBLIC_APP_NAME="SSO Company Management System"
APP_BASE_URL="http://localhost:3000"

# ---- Cron automation (see src/app/api/cron/daily and
# .github/workflows/cron-daily.yml) — daily job that activates overdue
# invoice detection, billing-due-soon reminders, project risk/delayed
# milestone flags, stale-approval escalation, and a daily digest. Without a
# scheduler hitting this route, none of those run on their own.
# Generate with: openssl rand -base64 32
# Set the SAME value here (Vercel env var) AND as the CRON_SECRET repo
# secret on GitHub (APP_BASE_URL above also needs to be a GitHub repo
# secret, pointed at the real production URL).
CRON_SECRET=""

# ---- Notifications (see src/lib/notifications) ----
# Outbound email via Gmail SMTP + nodemailer. Use a Google Account "App
# Password" (16 chars, no spaces) — NOT your normal Gmail password. Generate
# one at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be turned on for saranasinergi.optima@gmail.com first).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="saranasinergi.optima@gmail.com"
SMTP_APP_PASSWORD=""
SMTP_FROM_NAME="SSO Connect"

# Outbound WhatsApp — see lib/notifications/whatsapp.ts for the router.
# TWO providers exist; Cloud API wins automatically whenever both are set.
#
# 1) WhatsApp Business Cloud API (official, from Meta) — RECOMMENDED. Free
#    to use (no vendor subscription; Meta only bills per business-initiated
#    conversation, and this app's notifications are all cheap "Utility"
#    template conversations). Because it's the sanctioned method, the
#    number used here does NOT get suspended for "automation" the way
#    Fonnte-style gateways eventually do. Setup:
#      a. developers.facebook.com -> My Apps -> Create App -> type
#         "Business" -> add the "WhatsApp" product.
#      b. WhatsApp > API Setup shows a free test phone number and a
#         temporary 24h access token immediately — fine for a quick test,
#         but for production generate a PERMANENT token instead: Business
#         Settings > Users > System Users > Add -> assign the app you just
#         created -> Generate Token (scopes: whatsapp_business_messaging,
#         whatsapp_business_management). Paste that token below, not the
#         temporary one.
#      c. Copy the "Phone Number ID" shown on the same API Setup page
#         (NOT the phone number itself) into WHATSAPP_CLOUD_API_PHONE_NUMBER_ID.
#      d. WhatsApp Manager (business.facebook.com/wa/manage) > Message
#         Templates > Create Template — Category "Utility", Name
#         "sso_notifikasi", Language "Indonesian", Body:
#           Halo {{1}},
#
#           *{{2}}*
#           {{3}}
#
#           Buka di SSO Connect: {{4}}
#         Submit for review — Meta usually approves a Utility template
#         within minutes to about a day. Every notification this app sends
#         (task reminder, invoice due, quotation approved, etc.) reuses
#         this one template, with {{1}}-{{4}} filled per message — that's
#         why only ONE template needs approval, not one per notification
#         type.
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=""
# Only change these if you named/localized the template differently above,
# or Meta deprecates this Graph API version.
WHATSAPP_CLOUD_API_TEMPLATE_NAME="sso_notifikasi"
WHATSAPP_CLOUD_API_TEMPLATE_LANG="id"
WHATSAPP_CLOUD_API_VERSION="v21.0"

# 2) Fonnte (fonnte.com) — unofficial WA Web automation, no Meta
#    verification needed. Kept only as a fallback for while Cloud API isn't
#    set up yet — numbers used this way get suspended by WhatsApp over
#    time, which is exactly why WHATSAPP_CLOUD_API_TOKEN above exists.
FONNTE_TOKEN=""

# Master switch — set to "true" only once SMTP_APP_PASSWORD and at least one
# WhatsApp provider above are filled in. Keeps notifications silently
# in-app-only (safe default) until you've actually configured a provider,
# instead of throwing errors.
NOTIFICATIONS_OUTBOUND_ENABLED="false"

# ---- Telegram automation (revise a quotation by chatting with a bot —
# see app/api/telegram/webhook and lib/workflows/telegram-automation.ts) ----
# 1. DM @BotFather on Telegram, /newbot, paste the token it gives you here.
# 2. Pick any long random string for the secret below (Telegram just echoes
#    it back on every webhook call so this route can tell a genuine
#    Telegram request apart from a stranger hitting the URL directly).
# 3. Once deployed (this only works against a real public HTTPS URL, not
#    localhost), register the webhook ONCE:
#    curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=<APP_BASE_URL>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# 4. Each user who'll use this: DM the bot once, it replies with their Chat
#    ID, an Admin pastes that into Settings > Users > Edit > Telegram Chat ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ---- AI document extraction (see src/lib/ai) ----
# Reads uploaded customer PO / progress report PDFs (or photos) and suggests
# structured fields for a human to confirm — never writes a record on its
# own. Get a key at https://console.anthropic.com (Settings -> API Keys).
ANTHROPIC_API_KEY=""
# Cheap/fast model for extraction, not the app's UI-facing assistant model.
# Override if you want higher accuracy on hard-to-read scans, at higher cost.
ANTHROPIC_EXTRACTION_MODEL="claude-haiku-4-5-20251001"

# In-app "Tanya Asisten AI" chat widget (see src/server/assistant.ts) — one
# tier up from the extraction model since it does multi-step reasoning +
# tool use, not single-shot extraction. Override to a stronger/cheaper model
# depending on how much this gets used day to day.
ANTHROPIC_ASSISTANT_MODEL="claude-sonnet-5"
