// ============================================================================
// SSO Company Management System — Prisma Schema
// Core principle: enter data once, reuse it everywhere. Every entity below is
// wired with foreign keys so Sales -> Finance -> Project -> Documents share
// one relational graph instead of operating as silos.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — used at runtime by the app
  directUrl = env("DIRECT_URL")   // unpooled — used only for `prisma db push` / migrate
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SALES
  FINANCE
  PROJECT_MANAGER
  // View-only role for non-operational oversight (e.g. a Director who is not
  // day-to-day executive) — can see Sales/Finance/Project/Reports but cannot
  // create, edit, approve, or manage anything. See lib/permissions.ts MATRIX.
  VIEWER
  // Technical/data-integrity role. Can edit almost any record (Costing,
  // Quotation, Project, Invoice, Vendor PO, Documents) across every module —
  // this is the role that fixes what the automatic import/numbering pipeline
  // got wrong (duplicate or reversed document numbers, misfiled uploads,
  // wrong project match) when nobody else is allowed to touch a locked
  // record. Deliberately excluded from "approve" everywhere (financial
  // sign-off stays a business decision for ADMIN/Direktur, never a technical
  // one) — see lib/permissions.ts MATRIX and requireDataCorrector().
  IT
}

enum CustomerType {
  PROSPECT
  CUSTOMER
  PARTNER
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum OpportunityStatus {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SENT
  WON
  LOST
  EXPIRED
  CANCELLED
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  VERIFIED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  COMPLETED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  CANCELLED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum ExpenseCategory {
  LABOR
  MATERIALS
  TRANSPORTATION
  ACCOMMODATION
  VENDOR
  EQUIPMENT
  MARKETING
  OTHER
}

enum ExpensePaymentStatus {
  UNPAID
  PAID
}

// Maker-checker approval state for a ProjectExpense — separate from
// ExpensePaymentStatus (which tracks whether it's been paid out). An expense
// must be APPROVED before it counts toward project cost control / P&L.
enum ExpenseApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CREDIT_CARD
  OTHER
}

enum NumberEntityType {
  CUSTOMER
  LEAD
  OPPORTUNITY
  QUOTATION
  PURCHASE_ORDER
  CONTRACT
  PROJECT
  INVOICE
  PAYMENT
  EXPENSE
  COSTING
  JOB_ORDER
  GENERAL_DOCUMENT
  VENDOR_PO
  PROGRESS_REPORT
}

// Outbound procurement PO — SSO buying from a supplier/vendor to fulfill a
// job (e.g. "PT ATHENA TEKNIK PERKASA"). NOT the same document as
// PurchaseOrder above, which is the customer's PO confirming a deal TO SSO
// (spec/Sales pipeline "5. PO" folder). This one belongs in "04 Procurement".
// Verified against a real issued PO ("001/PO/PRO/VII/2026") — note the
// prefix is PO/PRO (Procurement), distinct from the Sales-side poPrefix.
enum VendorPurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SENT
  CONFIRMED
  CANCELLED
}

enum CostingStatus {
  DRAFT
  FINAL
  CONVERTED
}

enum ActivityAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  RESTORE
  UPLOAD
  DOWNLOAD
  APPROVE
  REJECT
  STATUS_CHANGE
  PAYMENT
  PROJECT_CREATED
  PROJECT_COMPLETED
  PROJECT_CLOSED
}

enum FolderKind {
  COMPANY
  PROJECT
  OPPORTUNITY
}

// ---------------------------------------------------------------------------
// USERS
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Quotation PDF signature block (spec: PIC/signer must be customizable per
  // quotation, not one fixed company signer). "title" is the jabatan printed
  // under the name (e.g. "Direktur", "Marketing Manager"). signatureImageUrl
  // points into private storage's branding/ area (see lib/storage.ts).
  title             String?
  signatureImageUrl String?
  // Profile photo shown in the sidebar/topbar and the "Aktivitas Saya"
  // dashboard hub — distinct from signatureImageUrl (that one is a TTD
  // graphic printed on PDFs, this one is just how the person is recognized
  // in the app). Self-service: any user can set their own via
  // updateOwnProfileAction (server/settings/profile.ts), not gated behind
  // the Admin-only "users" permission that guards signatureImageUrl.
  avatarUrl         String?
  // WhatsApp number for outbound approval/deadline notifications (see
  // lib/notifications/whatsapp.ts) — international format without "+",
  // e.g. "6281234567890". Null = WA notifications skipped for this user,
  // falls back to email only.
  whatsappNumber    String?

  // Maps an inbound Telegram chat back to a real User for the
  // quotation-revision-via-Telegram automation (see
  // lib/workflows/telegram-automation.ts) — an unregistered chat ID is
  // refused outright rather than treated as anonymous/system access. Set by
  // an Admin after the person DMs the bot once and is told their own chat ID
  // (there's no way to know it beforehand — Telegram assigns it on first
  // contact).
  telegramChatId    String? @unique

  opportunitiesAsSalesPic Opportunity[]     @relation("OpportunitySalesPic")
  quotationsCreated       Quotation[]       @relation("QuotationCreatedBy")
  quotationsAsSalesPic    Quotation[]       @relation("QuotationSalesPic")
  quotationsSubmitted     Quotation[]       @relation("QuotationSubmittedBy")
  quotationsApproved      Quotation[]       @relation("QuotationApprovedBy")
  quotationsRejected      Quotation[]       @relation("QuotationRejectedBy")
  quotationsSigned        Quotation[]       @relation("QuotationSigner")
  projectsManaged         Project[]         @relation("ProjectManager")
  projectsAsSalesPic      Project[]         @relation("ProjectSalesPic")
  projectsClosedBy        Project[]         @relation("ProjectClosedBy")
  tasksAssigned           ProjectTask[]     @relation("TaskAssignedTo")
  documentsUploaded       Document[]        @relation("DocumentUploadedBy")
  documentsDeleted        Document[]        @relation("DocumentDeletedBy")
  notifications           Notification[]
  activityLogs            ActivityLog[]
  createdCustomers        Customer[]        @relation("CustomerCreatedBy")
  createdCostingSheets    CostingSheet[]    @relation("CostingCreatedBy")
  numberRegistryEntriesCreated NumberRegistryEntry[] @relation("NumberRegistryCreatedBy")
  numberRegistryEntriesVoided  NumberRegistryEntry[] @relation("NumberRegistryVoidedBy")
  createdExpenses         ProjectExpense[]  @relation("ExpenseCreatedBy")
  expensesSubmitted       ProjectExpense[]  @relation("ExpenseSubmittedBy")
  expensesApproved        ProjectExpense[]  @relation("ExpenseApprovedBy")
  expensesRejected        ProjectExpense[]  @relation("ExpenseRejectedBy")
  createdInvoices         Invoice[]         @relation("InvoiceCreatedBy")
  invoicesSubmitted       Invoice[]         @relation("InvoiceSubmittedBy")
  invoicesApproved        Invoice[]         @relation("InvoiceApprovedBy")
  invoicesRejected        Invoice[]         @relation("InvoiceRejectedBy")
  createdPayments         Payment[]         @relation("PaymentCreatedBy")
  createdPurchaseOrders   PurchaseOrder[]   @relation("POCreatedBy")
  createdContracts        Contract[]        @relation("ContractCreatedBy")
  createdTasks            ProjectTask[]     @relation("TaskCreatedBy")
  invoicesAsSalesPic      Invoice[]         @relation("InvoiceSalesPic")
  createdVendorPOs        VendorPurchaseOrder[] @relation("VendorPOCreatedBy")
  vendorPOsSigned         VendorPurchaseOrder[] @relation("VendorPOSigner")
  vendorPOsSubmitted      VendorPurchaseOrder[] @relation("VendorPOSubmittedBy")
  vendorPOsApproved       VendorPurchaseOrder[] @relation("VendorPOApprovedBy")
  vendorPOsRejected       VendorPurchaseOrder[] @relation("VendorPORejectedBy")
  progressReportsCreated  ProgressReport[]      @relation("ProgressReportCreatedBy")
  progressReportsPrepared ProgressReport[]      @relation("ProgressReportPreparedBy")

  @@index([role])
}

// ---------------------------------------------------------------------------
// SALES: CUSTOMER / CONTACT / LEAD / OPPORTUNITY
// ---------------------------------------------------------------------------

model Customer {
  id           String         @id @default(cuid())
  number       String         @unique // CUS-2026-0001
  companyName  String
  customerType CustomerType   @default(PROSPECT)
  industry     String?
  address      String?
  city         String?
  province     String?
  country      String?
  taxId        String?
  phone        String?
  email        String?
  website      String?
  status       CustomerStatus @default(ACTIVE)
  notes        String?

  createdById String
  createdBy   User     @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  deletedById String?

  contacts       Contact[]
  leads          Lead[]
  opportunities  Opportunity[]
  quotations     Quotation[]
  costingSheets  CostingSheet[]
  purchaseOrders PurchaseOrder[]
  contracts      Contract[]
  projects       Project[]
  invoices       Invoice[]
  payments       Payment[]
  vendorPurchaseOrders VendorPurchaseOrder[]

  @@index([companyName])
  @@index([status])
  @@index([customerType])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name       String
  salutation String? // "Mr.", "Ms.", "Mrs." — used on quotation PDF's greeting line
  position  String?
  department String?
  email     String?
  phone     String?
  whatsapp  String?
  isPrimary Boolean  @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  quotations    Quotation[]
  invoices      Invoice[]

  @@index([customerId])
}

model Lead {
  id         String     @id @default(cuid())
  number     String     @unique // LED-2026-0001
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])

  companyName String
  contactName String?
  email       String?
  phone       String?
  source      String?
  status      LeadStatus @default(NEW)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([status])
}

model Opportunity {
  id         String   @id @default(cuid())
  number     String   @unique // OPP-2026-0001
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])

  name                String
  description         String?
  estimatedValue      Decimal            @db.Decimal(18, 2)
  probability          Int               @default(10) // 0-100
  expectedClosingDate DateTime?
  salesPicId          String
  salesPic            User               @relation("OpportunitySalesPic", fields: [salesPicId], references: [id])
  source              String?
  status              OpportunityStatus  @default(NEW)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  quotations    Quotation[]
  projects      Project[]
  costingSheets CostingSheet[]
  folders       Folder[]

  @@index([status])
  @@index([customerId])
  @@index([salesPicId])
}

// ---------------------------------------------------------------------------
// SALES: QUOTATION (critical module + approval workflow)
// ---------------------------------------------------------------------------

model Quotation {
  id            String    @id @default(cuid())
  number        String    @unique // QT-2026-0001
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  quotationDate DateTime  @default(now())
  validUntil    DateTime?
  salesPicId    String
  salesPic      User      @relation("QuotationSalesPic", fields: [salesPicId], references: [id])
  // Who signs this specific quotation's PDF (name, title, and signature
  // image are pulled from this user). Defaults to salesPicId when the
  // quotation is created, but is fully overridable per document — e.g. a
  // Director signs high-value quotes while a Sales Manager signs routine
  // ones. This is what makes PIC/TTD customizable instead of fixed.
  signerId      String?
  signer        User?     @relation("QuotationSigner", fields: [signerId], references: [id])
  description   String?
  subjectLine   String? // PDF "SUBJECT" line, e.g. "Quotation — Bracket Idler for Mechanical Parts"; falls back to description
  terms         String?
  notes         String?
  // Structured "B. TERMS & CONDITIONS" grid for the PDF (Pricing, Validity,
  // Lead Time, Scope of Work, Payment Terms, Warranty). Array of
  // { title: string, body: string }. Pre-filled with SSO's standard six
  // items on creation, editable per quotation, always rendered in this
  // fixed order on the PDF to match the company SOP layout.
  commercialTerms Json?

  // Revision counter for the SOP's ".R1" / ".R2" suffix (verified against
  // real issued quotations, e.g. "005/QUO/MKT/V/2026.R2"). The base `number`
  // above is issued once and never changes — revising a quotation bumps this
  // counter instead of burning a new sequence number, so the printed/display
  // number becomes "{number}.R{revision}" once revision > 0. See
  // lib/pdf/format.ts:formatRevisedNumber and lib/workflows/quotation.ts:
  // reviseQuotation (the action that increments this and re-opens the
  // quotation for editing).
  revision Int @default(0)

  subtotal   Decimal @db.Decimal(18, 2) @default(0)
  discount   Decimal @db.Decimal(18, 2) @default(0)
  tax        Decimal @db.Decimal(18, 2) @default(0)
  grandTotal Decimal @db.Decimal(18, 2) @default(0)

  status   QuotationStatus @default(DRAFT)
  isLocked Boolean         @default(false) // locked once submitted for approval

  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("QuotationSubmittedBy", fields: [submittedById], references: [id])
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  rejectedAt    DateTime?
  rejectedById  String?
  rejectedBy    User?     @relation("QuotationRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?
  sentAt        DateTime?
  wonAt         DateTime?
  lostAt        DateTime?
  lostReason    String?

  createdById String
  createdBy   User     @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  items          QuotationItem[]
  purchaseOrders PurchaseOrder[]
  contracts      Contract[]
  project        Project?
  invoices       Invoice[]
  costingSheet   CostingSheet?
  revisionHistory QuotationRevisionHistory[]

  @@index([status])
  @@index([customerId])
  @@index([salesPicId])
}

// Read-only snapshot of a Quotation's items/totals/description as they stood
// at one past revision, taken right before that revision gets superseded
// (see reviseQuotation / reviseCostingSheet's cross-reopen in
// lib/workflows/quotation.ts and lib/workflows/costing.ts) — the live
// Quotation row keeps mutating in place exactly as before; this is purely
// an audit trail so R1/R2/... stay visible after being overwritten. Never
// convertible or editable — viewing only (spec: history is for looking
// back, not for re-issuing an old revision).
model QuotationRevisionHistory {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision    Int
  snapshot    Json
  createdAt   DateTime  @default(now())

  @@unique([quotationId, revision])
  @@index([quotationId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  itemName        String
  description     String?
  technicalSpec   String? // shown in its own PDF column, e.g. "A36/SS400, Sandblast SA 2.5, Painting 250 micron"
  quantity        Decimal @db.Decimal(18, 4)
  unit            String  @default("unit")
  unitPrice       Decimal @db.Decimal(18, 2)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  taxPercent      Decimal @db.Decimal(5, 2) @default(0)
  total           Decimal @db.Decimal(18, 2)
  sortOrder       Int     @default(0)

  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// SALES: COSTING (dynamic per-project costing worksheet, mobile-friendly)
// ---------------------------------------------------------------------------
// Spec: PIC builds a costing sheet from customer's supply request (highly
// variable goods/services), entering Cost + per-line target Margin % for
// each item (cross-subsidization between lines is expected — some lines
// carry more margin to cover others priced near cost). Selling price is
// ALWAYS derived server-side: sellingUnitPrice = cost / (1 - margin%).
// A finished costing sheet can be converted directly into a Quotation,
// carrying line items across so nothing is re-typed (section 38 principle).

model CostingSheet {
  id         String        @id @default(cuid())
  number     String        @unique // CST-2026-0001
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  projectTitle String // e.g. "Quotation for Gearbox Drive Unit Maintenance & Servicing"
  jobNo        String?
  costingDate  DateTime      @default(now())
  status       CostingStatus @default(DRAFT)
  notes        String?

  // Same ".R1"/".R2" revision suffix convention as Quotation.revision — see
  // that field's comment. Bumped via reviseCostingSheet(); display number is
  // "{number}.R{revision}" once revision > 0.
  revision Int @default(0)

  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  // Profitability summary (spec: matches SSO's real costing SOP exactly —
  // verified line-by-line against the "COSTING JPC - GEARBOX" reference).
  // PPN and PPh Final are both charged as a % of Total COGS (input VAT +
  // withholding tax on vendor/procurement spend), not of revenue. Editable
  // per sheet since rates and the operational estimate vary by job.
  operationalCost  Decimal @db.Decimal(18, 2) @default(0)
  ppnPercent       Decimal @db.Decimal(5, 2) @default(11)
  pphFinalPercent  Decimal @db.Decimal(5, 2) @default(2)

  createdById String
  createdBy   User     @relation("CostingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  sections CostingSection[]
  revisionHistory CostingSheetRevisionHistory[]

  @@index([customerId])
  @@index([status])
}

// Read-only snapshot of a Costing Sheet's sections/items/summary inputs as
// they stood at one past revision — see QuotationRevisionHistory's comment
// for the full rationale (same pattern, taken at the same moment, right
// before reviseCostingSheet/reviseQuotation overwrites this sheet's content
// for the next revision).
model CostingSheetRevisionHistory {
  id             String       @id @default(cuid())
  costingSheetId String
  costingSheet   CostingSheet @relation(fields: [costingSheetId], references: [id], onDelete: Cascade)
  revision       Int
  snapshot       Json
  createdAt      DateTime     @default(now())

  @@unique([costingSheetId, revision])
  @@index([costingSheetId])
}

// One row per in-flight Telegram revision awaiting a "ya"/"batal" reply (see
// app/api/telegram/webhook/route.ts). Deliberately DB-backed rather than an
// in-memory map — a serverless/multi-instance deployment can't rely on the
// next webhook call landing on the same process, and the whole point is
// surviving the gap between "here's what would change" and the human's
// reply. actionJson is the parsed command (see lib/ai/parse-revision-command.ts)
// re-applied unchanged at commit time — never re-parsed from the original
// text, so what gets confirmed is exactly what gets applied.
model TelegramPendingRevision {
  id          String   @id @default(cuid())
  chatId      String
  quotationId String
  costingId   String
  actionJson  Json
  previewText String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([chatId])
}

// In-progress "buat costing baru" flow via Telegram (see
// lib/workflows/telegram-costing-draft.ts). Unlike TelegramPendingRevision
// (one parsed action awaiting a single "ya"), a new costing sheet needs
// several pieces of information (customer, project title, a list of items)
// that rarely arrive in one message — this accumulates them across turns.
// DB-backed for the same reason as TelegramPendingRevision: a serverless
// deployment can't guarantee two messages from the same chat land on the
// same process.
model TelegramCostingDraft {
  id              String   @id @default(cuid())
  chatId          String
  customerId      String?
  customerName    String? // resolved company name, shown back in the preview
  projectTitle    String?
  jobNo           String?
  operationalCost Decimal  @db.Decimal(18, 2) @default(0)
  itemsJson       Json     @default("[]") // CostingLineItemInput[] collected so far
  // COLLECTING = still gathering required fields; CONFIRMING = all required
  // fields present, showing a preview and waiting for "ya"/"batal"/more items.
  stage           String   @default("COLLECTING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime

  @@index([chatId])
}

model CostingSection {
  id             String       @id @default(cuid())
  costingSheetId String
  costingSheet   CostingSheet @relation(fields: [costingSheetId], references: [id], onDelete: Cascade)

  code      String // "A", "B", ...
  name      String // "MECHANICAL", "OTHERS"
  sortOrder Int    @default(0)

  items CostingLineItem[]

  @@index([costingSheetId])
}

model CostingLineItem {
  id        String         @id @default(cuid())
  sectionId String
  section   CostingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  groupLabel String? // optional sub-heading shared by several lines, e.g. "1. SERVICE GEARBOX"
  name        String // Equipment / item name
  description String?
  quantity    Decimal @db.Decimal(18, 4) @default(1)
  unit        String  @default("lot")
  currency    String  @default("IDR")

  costUnitPrice          Decimal @db.Decimal(18, 2) // cost per unit, before supplier discount
  supplierDiscountPercent Decimal @db.Decimal(5, 2) @default(0)
  marginPercent           Decimal @db.Decimal(5, 2) @default(0) // target margin on SELLING price

  // Server-computed & persisted at save time (never trust client math):
  costTotal         Decimal @db.Decimal(18, 2) @default(0) // costUnitPrice * qty * (1 - supplierDiscount%)
  sellingUnitPrice   Decimal @db.Decimal(18, 2) @default(0) // costPerUnitAfterDiscount / (1 - margin%)
  sellingTotalPrice  Decimal @db.Decimal(18, 2) @default(0) // sellingUnitPrice * qty

  sortOrder Int @default(0)

  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// SALES: PURCHASE ORDER / CONTRACT
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id         String              @id @default(cuid())
  // The customer's OWN PO reference, typed in as-is (e.g. "EPC-L/2026-0450",
  // "2026/BPN-L-0505") — this is an inbound document SSO did not issue, so
  // unlike Quotation/Invoice/VendorPurchaseOrder (which SSO creates and
  // therefore numbers itself via generateNumber()), there is no SSO sequence
  // to invent here. Uniqueness is scoped per customer, not global, since two
  // unrelated customers' own numbering schemes could coincidentally collide.
  number     String
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  quotationId String?
  quotation  Quotation?          @relation(fields: [quotationId], references: [id])
  projectId  String?
  project    Project?            @relation(fields: [projectId], references: [id])

  poDate    DateTime            @default(now())
  poValue   Decimal             @db.Decimal(18, 2)
  startDate DateTime?
  endDate   DateTime?
  status    PurchaseOrderStatus @default(PENDING)

  // Term of Payment / Term of Delivery exactly as printed on the real PO
  // (e.g. "40% DP, 50% Before Delivered, 10% Retention") — captured by the
  // AI extraction step (extract-purchase-order.ts) or typed in manually.
  // This is what makes "what's the next billing stage" answerable from the
  // app itself instead of a one-off chat calculation nobody can see again.
  paymentTerms  String?
  deliveryTerms String?

  // A real calendar date, resolved once (at extraction/entry time) from
  // deliveryTerms + poDate — e.g. "ETA MAX 6 Weeks ARO" from a PO dated
  // 20 Jul 2026 becomes 31 Aug 2026. deliveryTerms stays the source of
  // truth text; this is what lets the UI show an actual date instead of
  // making a human re-do that arithmetic by hand every time. Nullable and
  // editable — not every term of delivery resolves to one exact date, and
  // this is an estimate the human confirms, not a contractual guarantee.
  estimatedDeliveryDate DateTime?

  createdById String
  createdBy   User     @relation("POCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  contracts  Contract[]
  milestones ProjectMilestone[]

  @@unique([customerId, number])
  @@index([status])
  @@index([customerId])
  @@index([projectId])
}

model Contract {
  id         String         @id @default(cuid())
  number     String         @unique // CTR-2026-0001
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  quotationId String?
  quotation  Quotation?     @relation(fields: [quotationId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  projectId  String?
  project    Project?       @relation(fields: [projectId], references: [id])

  contractValue Decimal        @db.Decimal(18, 2)
  startDate     DateTime
  endDate       DateTime
  status        ContractStatus @default(DRAFT)
  notes         String?

  createdById String
  createdBy   User     @relation("ContractCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([customerId])
  @@index([endDate])
}

// ---------------------------------------------------------------------------
// PROCUREMENT: VENDOR PURCHASE ORDER (SSO -> Vendor, distinct from the
// customer-received PurchaseOrder above)
// ---------------------------------------------------------------------------

model VendorPurchaseOrder {
  id     String @id @default(cuid())
  number String @unique // 001/PO/PRO/VII/2026

  vendorName    String
  vendorAddress String?
  vendorEmail   String?
  vendorAttn    String?

  // Ship-to block — often the end customer's site (drop-ship), not SSO's
  // own office, matching the real PO's "DELIVERY ADDRESS" box.
  deliveryName    String?
  deliveryAddress String?
  deliveryAttn    String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])

  poDate        DateTime @default(now())
  quotationRef  String? // vendor's own quotation number, free text
  projectRef    String? // internal job/project reference shown on the PO
  paymentTerms  String?
  deliveryTerms String?

  subtotal   Decimal @db.Decimal(18, 2) @default(0)
  discount   Decimal @db.Decimal(18, 2) @default(0)
  taxPercent Decimal @db.Decimal(5, 2) @default(11)
  tax        Decimal @db.Decimal(18, 2) @default(0)
  grandTotal Decimal @db.Decimal(18, 2) @default(0)

  notes  String? // "Note / Ketentuan" block, freeform (numbered by the user)
  status VendorPurchaseOrderStatus @default(DRAFT)
  // Maker-checker: once submitted, isLocked prevents the maker from editing
  // until approved/rejected — mirrors Quotation's pattern exactly.
  isLocked Boolean @default(false)

  signerId String?
  signer   User?   @relation("VendorPOSigner", fields: [signerId], references: [id])

  submittedAt    DateTime?
  submittedById  String?
  submittedBy    User?     @relation("VendorPOSubmittedBy", fields: [submittedById], references: [id])
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?     @relation("VendorPOApprovedBy", fields: [approvedById], references: [id])
  rejectedAt     DateTime?
  rejectedById   String?
  rejectedBy     User?     @relation("VendorPORejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?

  createdById String
  createdBy   User      @relation("VendorPOCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  items VendorPurchaseOrderItem[]
  // The Finance-side half of this PO's cost — see ProjectExpense.
  // vendorPurchaseOrderId for how/when it's created (markVendorPOSent).
  expense ProjectExpense?

  @@index([status])
  @@index([projectId])
  @@index([customerId])
}

model VendorPurchaseOrderItem {
  id                    String              @id @default(cuid())
  vendorPurchaseOrderId String
  vendorPurchaseOrder   VendorPurchaseOrder @relation(fields: [vendorPurchaseOrderId], references: [id], onDelete: Cascade)

  // Bold section header shared by several lines, e.g. "1  MOTOR 55 KW 75 HP"
  // — only printed on the PDF when it changes from the previous row, same
  // convention as CostingLineItem.groupLabel.
  groupLabel  String?
  description String
  quantity    Decimal @db.Decimal(18, 4) @default(1)
  unit        String  @default("lot")
  unitPrice   Decimal @db.Decimal(18, 2) @default(0)
  amount      Decimal @db.Decimal(18, 2) @default(0)
  sortOrder   Int     @default(0)

  @@index([vendorPurchaseOrderId])
}

// ---------------------------------------------------------------------------
// PROJECT (auto-created when Quotation -> WON)
// ---------------------------------------------------------------------------

model Project {
  id         String   @id @default(cuid())
  number     String   @unique // PRJ-2026-0001
  name       String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  quotationId   String?      @unique
  quotation     Quotation?   @relation(fields: [quotationId], references: [id])

  projectManagerId String?
  projectManager    User?    @relation("ProjectManager", fields: [projectManagerId], references: [id])
  salesPicId        String?
  salesPic          User?    @relation("ProjectSalesPic", fields: [salesPicId], references: [id])

  // Free-text "Job Number" (spec: found in SSO's own real job-costing sheet
  // as "NO JO" — a short internal code like "226" or "BPN-0505", distinct
  // from the formal system-generated Project.number). Manually assigned by
  // whoever books the job into cost tracking; NOT auto-generated, since real
  // usage mixes quotation-derived, PO-derived, and site-prefixed codes with
  // no single fixed pattern. Left blank until Finance/PM assigns one.
  jobNumber String?

  startDate     DateTime?
  endDate       DateTime?
  contractValue Decimal       @db.Decimal(18, 2) @default(0)
  budget        Decimal       @db.Decimal(18, 2) @default(0)
  status        ProjectStatus @default(PLANNING)
  progressPercent Int         @default(0)

  closingChecklist Json?     // { taskCompleted: bool, bastUploaded: bool, ... }
  completedAt      DateTime?
  closedAt         DateTime?
  closedById       String?
  closedBy         User?     @relation("ProjectClosedBy", fields: [closedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  purchaseOrders PurchaseOrder[]
  contracts      Contract[]
  tasks          ProjectTask[]
  milestones     ProjectMilestone[]
  expenses       ProjectExpense[]
  invoices       Invoice[]
  payments       Payment[]
  folders        Folder[]
  vendorPurchaseOrders VendorPurchaseOrder[]
  progressReports ProgressReport[]

  @@index([status])
  @@index([customerId])
  @@index([projectManagerId])
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  startDate   DateTime?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  progressPercent Int      @default(0)
  notes       String?

  createdById String
  createdBy   User     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name            String
  dueDate         DateTime?
  status          MilestoneStatus @default(PENDING)
  progressPercent Int             @default(0)
  description     String?
  sortOrder       Int             @default(0)

  // S-curve inputs (spec: Kurva S — progress rencana vs realisasi vs
  // penagihan). weightPercent = kontribusi milestone ini terhadap total
  // scope project (idealnya semua milestone dalam satu project berjumlah
  // 100%) — dipakai untuk menghitung kumulatif "Rencana" (dari dueDate) dan
  // "Realisasi" (dari completedAt). Tidak wajib diisi; kalau kosong,
  // milestone itu tidak ikut dihitung ke kurva sampai bobotnya diisi.
  weightPercent Decimal   @db.Decimal(5, 2) @default(0)
  completedAt   DateTime?

  // Links this milestone back to the real customer PO stage it represents
  // (Aug 2026 — founder request: editing the PO's DP/delivery date must
  // cascade to everything downstream, not sit as a disconnected snapshot).
  // When set, dueDate is NOT a free-standing fact a PM edits directly here —
  // it's kept in sync by updatePurchaseOrder() whenever the linked PO's
  // poDate/estimatedDeliveryDate changes (see server/sales/purchase-orders.ts).
  // dateBasis says WHICH PO field this milestone tracks:
  //   "PO_DATE"            — e.g. the DP stage, tied to when the PO/DP itself
  //                          landed (PurchaseOrder.poDate).
  //   "ESTIMATED_DELIVERY" — e.g. Before Delivery/Retention stages, tied to
  //                          PurchaseOrder.estimatedDeliveryDate.
  // Null sourcePurchaseOrderId (the common case for a manually-added
  // milestone) means dueDate stays a plain, directly-editable field — the
  // two milestone "flavors" (PO-derived vs manual) coexist on purpose.
  sourcePurchaseOrderId String?
  sourcePurchaseOrder   PurchaseOrder? @relation(fields: [sourcePurchaseOrderId], references: [id], onDelete: SetNull)
  dateBasis             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ProjectExpense {
  id        String          @id @default(cuid())
  number    String          @unique // EXP-2026-0001
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category      ExpenseCategory
  description   String
  vendor        String?
  date          DateTime        @default(now())
  amount        Decimal         @db.Decimal(18, 2)
  tax           Decimal         @db.Decimal(18, 2) @default(0)
  total         Decimal         @db.Decimal(18, 2)
  paymentStatus ExpensePaymentStatus  @default(UNPAID)
  approvalStatus ExpenseApprovalStatus @default(DRAFT)
  isLocked       Boolean               @default(false)

  // Set when this expense IS a Vendor PO's cost, not a manually-typed one —
  // auto-created by markVendorPOSent (lib/workflows/vendor-po.ts) so a Vendor
  // PO's payment goes through the same evidence-gated Approve -> Mark as Paid
  // flow as every other project cost, instead of a separate parallel payment
  // system. @unique enforces the 1:1 (one Vendor PO, one linked Expense).
  vendorPurchaseOrderId String?              @unique
  vendorPurchaseOrder   VendorPurchaseOrder? @relation(fields: [vendorPurchaseOrderId], references: [id])

  submittedAt    DateTime?
  submittedById  String?
  submittedBy    User?     @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  rejectedAt     DateTime?
  rejectedById   String?
  rejectedBy     User?     @relation("ExpenseRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?

  createdById String
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([category])
  @@index([approvalStatus])
}

// Field engineering progress/inspection report — real template found in
// SSO's WhatsApp field-report archive (doc no. "ENG-REP-004"): per visit,
// engineer logs a dated checklist of parts inspected/repaired, each with a
// before photo, an after photo, and a note. Intentionally NOT part of the
// maker-checker approval chain like Quotation/Invoice/Expense — this is an
// internal field record, not a commercial document requiring Direktur
// sign-off. isDone on each item is a deliberately simple manual flag for
// now (spec: could later roll up into ProjectMilestone.completedAt to
// auto-drive the Kurva S "Realisasi" line, but that link is intentionally
// deferred until this base feature is proven in real use).
model ProgressReport {
  id        String  @id @default(cuid())
  number    String  @unique // ENG-REP/OPS-2026-0001 style, via generateNumber(PROGRESS_REPORT)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  inspectionDate DateTime
  location       String?

  // Written for management, not for the workshop. The checkpoint table answers
  // "what was done"; these two answer "where does this job stand" — the
  // question a director actually opens the report to settle.
  summary        String?
  overallPercent Int?

  // SSO's real reports carry a theme per issue ("Identifikasi Bearing &
  // Kebutuhan Spare Parts") and come in two shapes: PEMERIKSAAN lists parts,
  // type, qty and stock; PROGRES shows before/after photos of work done. One
  // ENG-REP series, two layouts — driven by the stage the job is in.
  title      String?
  reportKind String? @default("PROGRES") // "PEMERIKSAAN" | "PROGRES"

  preparedById String
  preparedBy   User   @relation("ProgressReportPreparedBy", fields: [preparedById], references: [id])

  // Links this report to the real uploaded PDF/photo it was generated from
  // (see extract-progress-report.ts + ProgressReportDocumentsPanel) — one
  // report per source file, so the checklist can be shown as a dropdown
  // right under that file in the timeline instead of a separate hand-typed
  // record disconnected from the document. Null for any report created the
  // old manual way, or if the source document is later deleted.
  sourceDocumentId String?   @unique
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  aiGenerated      Boolean   @default(false)

  createdById String
  createdBy   User      @relation("ProgressReportCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  items ProgressReportItem[]

  @@index([projectId])
}

model ProgressReportItem {
  id               String         @id @default(cuid())
  progressReportId String
  progressReport   ProgressReport @relation(fields: [progressReportId], references: [id], onDelete: Cascade)

  // Section heading in the printed report, e.g. "DINAMO MOTOR 55 KW" /
  // "DINAMO MOTOR 45 KW". SSO's real reports group checkpoints by the unit
  // being worked on; without this the PDF is one flat list and a reader
  // cannot tell which motor a bearing belongs to.
  sectionName String?

  partName  String // "Bagian yang dicek"
  notes     String? // "Keterangan"
  isDone    Boolean @default(false)
  sortOrder Int     @default(0)

  // Private storage keys (see lib/storage.ts) — never a public URL, always
  // streamed through a session-gated route, same pattern as branding assets.
  photoBeforeKey  String?
  photoBeforeSize Int?
  photoAfterKey   String?
  photoAfterSize  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([progressReportId])
}

// ---------------------------------------------------------------------------
// FINANCE: INVOICE / PAYMENT
// ---------------------------------------------------------------------------

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique // INV-2026-0001
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id])

  invoiceDate DateTime      @default(now())
  dueDate     DateTime
  subtotal    Decimal       @db.Decimal(18, 2) @default(0)
  discount    Decimal       @db.Decimal(18, 2) @default(0)
  tax         Decimal       @db.Decimal(18, 2) @default(0)
  grandTotal  Decimal       @db.Decimal(18, 2) @default(0)
  paidAmount  Decimal       @db.Decimal(18, 2) @default(0)
  status      InvoiceStatus @default(DRAFT)
  // Maker-checker: locked while awaiting Direktur approval, same pattern as
  // Quotation/VendorPurchaseOrder — the maker cannot edit or self-approve.
  isLocked    Boolean       @default(false)

  submittedAt    DateTime?
  submittedById  String?
  submittedBy    User?     @relation("InvoiceSubmittedBy", fields: [submittedById], references: [id])
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?     @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])
  rejectedAt     DateTime?
  rejectedById   String?
  rejectedBy     User?     @relation("InvoiceRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?

  // Fields verified against a real issued invoice ("001/INV/FIN/VIII/2026")
  // so the PDF can carry the same header block: the customer's own PO
  // reference/date, an expected delivery date, who from Sales owns the
  // deal, and the internal Job Order number. All optional — filled in as
  // known, never block issuing the invoice.
  customerPO   String?
  poDate       DateTime?
  deliveryDate DateTime?
  jobNo        String?
  salesPicId   String?
  salesPic     User?     @relation("InvoiceSalesPic", fields: [salesPicId], references: [id])
  // Free-text "NOTE:" block on the PDF (scope inclusions, spare-part
  // conditions, etc.) — kept freeform like Quotation.notes/CostingSheet.notes
  // since real invoices vary too much in structure to force into a rigid
  // titled-list schema.
  notes        String?
  // Set when this invoice only bills a percentage of the job (a down
  // payment / termin), matching the real invoice's "TOTAL AMOUNT DUE (DP
  // 20% inc. VAT)" line. Null/0 = this invoice bills the full grandTotal.
  dpPercent    Decimal?  @db.Decimal(5, 2)

  // Cumulative PPh 23 (or other withholding) the CUSTOMER deducted before
  // paying — a legal deduction the customer is entitled to make, not a
  // shortfall. It settles the invoice just as much as cash does: SSO holds
  // a Bukti Potong for this amount, which is a tax credit against SSO's own
  // liability, not money still owed by the customer. Mirrors paidAmount —
  // incremented alongside it whenever a payment records a withholding, kept
  // as a separate field (rather than folded into paidAmount) so cash
  // actually received in the bank and tax credited are never conflated.
  // See lib/workflows/calculations.ts:invoiceOutstanding().
  withholdingTax Decimal @db.Decimal(18, 2) @default(0)

  createdById String
  createdBy   User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@index([customerId])
  @@index([projectId])
  @@index([dueDate])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @db.Decimal(18, 4) @default(1)
  unit        String  @default("unit")
  unitPrice   Decimal @db.Decimal(18, 2)
  taxPercent  Decimal @db.Decimal(5, 2) @default(0)
  total       Decimal @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  // Real invoices group several priced/unpriced lines under one bold
  // section header (e.g. "1. OVERHOUL GEARBOX DODGE MAGNEGEAR 100K") — see
  // the real "001/INV/FIN/VIII/2026". groupLabel repeats on every row that
  // shares the heading; the PDF only prints it when it changes from the
  // previous row. isNote marks a line as a plain scope-description bullet
  // with no quantity/price of its own (rendered as description-only text,
  // quantity/unitPrice/total on that row are just 0 placeholders).
  groupLabel String?
  isNote     Boolean @default(false)

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  number    String   @unique // PAY-2026-0001
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(18, 2)
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  bankAccount     String?
  notes           String?
  // PPh 23 (or similar) the customer withheld before transferring this
  // specific payment — see Invoice.withholdingTax for why this counts as
  // settling the invoice rather than leaving it outstanding.
  withholdingTax  Decimal       @db.Decimal(18, 2) @default(0)

  createdById String
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([invoiceId])
  @@index([projectId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// DOCUMENT MANAGEMENT
// ---------------------------------------------------------------------------

model Folder {
  id       String     @id @default(cuid())
  name     String
  kind     FolderKind
  parentId String?
  parent   Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[]   @relation("FolderTree")

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Opportunity-stage folders (spec: pre-Won documents need a home too —
  // created the moment an Opportunity is logged, before any Quotation even
  // exists yet, let alone a Won deal). See lib/workflows/folders.ts:
  // createOpportunityFolders / OPPORTUNITY_FOLDER_TEMPLATE.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  routeKey  String?  // stable key for auto-routing, e.g. "SALES/QUOTATION", "FINANCE/INVOICE", "CLOSING/BAST"
  isSystem  Boolean  @default(true) // system folders cannot be deleted by normal users
  path      String   // materialized display path, e.g. "PRJ-2026-0001 - PT ABC / 01 Sales / Quotation"

  createdAt DateTime @default(now())

  documents Document[]

  @@index([parentId])
  @@index([projectId])
  @@index([opportunityId])
  @@index([routeKey])
}

model Document {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  storageDriver String  @default("local")
  storagePath  String   // internal key, never exposed to client directly

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id])

  relatedEntityType String? // "CUSTOMER" | "OPPORTUNITY" | "QUOTATION" | "PO" | "CONTRACT" | "PROJECT" | "INVOICE" | "PAYMENT" | "EXPENSE"
  relatedEntityId   String?

  uploadedById String
  uploadedBy   User     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
  version      Int      @default(1)
  description  String?

  deletedAt   DateTime? // soft delete = Trash
  deletedById String?
  deletedBy   User?     @relation("DocumentDeletedBy", fields: [deletedById], references: [id])

  // Back-relation for ProgressReport.sourceDocument (AI-generated checklist
  // tied to this exact file, at most one per document).
  progressReport ProgressReport?

  @@index([folderId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS / ACTIVITY LOG / NUMBERING / SETTINGS
// ---------------------------------------------------------------------------

model Notification {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  type    String   // e.g. "QUOTATION_APPROVAL", "INVOICE_OVERDUE", "PROJECT_DEADLINE", "CONTRACT_EXPIRING", "PROJECT_CLOSING_INCOMPLETE"
  title   String
  message String
  link    String?
  isRead  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  action      ActivityAction
  entityType  String
  entityId    String
  description String
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model NumberSequence {
  id            String           @id @default(cuid())
  entityType    NumberEntityType
  year          Int
  prefix        String
  currentNumber Int              @default(0)
  padding       Int              @default(3)

  updatedAt DateTime @updatedAt

  @@unique([entityType, year])
}

// Front-door number intake (spec: "ambil nomor dulu" before drafting any
// quotation or letter — mirrors SSO's real registry: pick a document type,
// fill date/subject/PIC, get a number back immediately). Reuses the same
// per-(docType, year) sequence as generateNumber() in lib/numbering.ts, so
// numbers taken here are never duplicated or skipped relative to the rest
// of the system. Once issued a number is never reused, even if voided
// (voidedAt) — voiding only marks it cancelled for display purposes.
// docTypeCode / deptCode are free strings (not enums) matching SSO's real
// document-type and department code lists (see DOCUMENT_TYPE_CODES /
// DEPARTMENT_CODES in lib/validation/numbering.ts) — kept as plain strings
// rather than Prisma enums because this list is company policy, not a
// database entity, and may grow without a schema migration.
model NumberRegistryEntry {
  id         String   @id @default(cuid())
  docTypeCode String  // e.g. "SK", "QUO", "INV", "BAST"...
  deptCode    String  // e.g. "MKT", "FIN", "DIR"...
  number     String   @unique
  numberDate DateTime
  subject    String // Perihal / Nama Proyek
  picName    String // Nama Peminta

  createdById String
  createdBy   User     @relation("NumberRegistryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("NumberRegistryVoidedBy", fields: [voidedById], references: [id])

  @@index([docTypeCode])
  @@index([number])
}

// Sequence counter dedicated to the general document registry above —
// separate from NumberSequence (which backs entity-linked auto-numbering
// for Quotation/Invoice/Costing/etc. created through their own modules).
// Keyed by docTypeCode only (not department) — one running count per
// document type per year, matching standard Indonesian corporate "nomor
// surat keluar" convention, regardless of which department issued it.
model RegistryNumberSequence {
  id            String   @id @default(cuid())
  docTypeCode   String
  year          Int
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([docTypeCode, year])
}

model CompanySettings {
  id      String @id @default("singleton")
  companyName  String  @default("PT Sarana Sinergi Optima")
  logoUrl      String?
  address      String?
  // Second address line (kecamatan/kota/kode pos, e.g. "Pondok Pinang,
  // Kebayoran Lama, Jakarta Selatan 12310") — printed on its own line under
  // `address` in PDF headers/footers, matching the real letterhead format
  // (spec point #1: full address must show, not just "Jakarta").
  addressLine2 String?
  city         String?
  province     String?
  country      String? @default("Indonesia")
  phone        String?
  email        String?
  taxId        String?
  currency     String  @default("IDR")
  timezone     String  @default("Asia/Jakarta")
  fiscalYearStartMonth Int @default(1)
  defaultTaxRatePercent Decimal @db.Decimal(5,2) @default(11)

  // Prefix is the literal string placed between the sequence and the roman
  // month in the number (see lib/numbering.ts): {seq}/{prefix}/{month}/{year}.
  // It may itself contain "/" to encode a department code (e.g. "QUO/MKT"),
  // matching SSO's real numbering SOP — verified against the company's
  // numbering registry (e.g. "004/QUO/MKT/VII/2026"). All editable per
  // entity type in Settings > Numbering.
  customerPrefix    String @default("CUS/MKT")
  leadPrefix        String @default("LED/MKT")
  opportunityPrefix String @default("OPP/MKT")
  quotationPrefix   String @default("QUO/MKT")
  poPrefix          String @default("PO/MKT")
  contractPrefix    String @default("CTR/MKT")
  projectPrefix     String @default("PRJ/OPS")
  invoicePrefix     String @default("INV/FIN")
  paymentPrefix     String @default("PAY/FIN")
  expensePrefix     String @default("EXP/FIN")
  costingPrefix     String @default("CST/MKT")
  jobOrderPrefix        String @default("JO/MKT")
  generalDocumentPrefix String @default("SSO-SURAT")
  // Outbound vendor/procurement PO — verified against a real issued PO
  // ("001/PO/PRO/VII/2026"). Deliberately separate from poPrefix above,
  // which is the customer-received PO in the Sales pipeline.
  vendorPoPrefix    String @default("PO/PRO")
  // Field engineering progress/inspection reports (spec: real internal
  // template found in SSO's WhatsApp archive, doc no. "ENG-REP-004" —
  // photo-based before/after checklist per project). Kept as its own
  // configurable prefix like every other document type rather than
  // hardcoding "ENG-REP", consistent with how quotationPrefix/costingPrefix
  // etc. are all Settings-editable.
  progressReportPrefix String @default("ENG-REP/OPS")
  numberPadding     Int    @default(3)

  // "PAYMENT INSTRUCTIONS" bank block printed on the Invoice PDF (spec:
  // matches the real invoice's "Bank Transfer Info" box exactly). All
  // optional — the invoice just omits the box until these are filled in
  // under Settings > Company.
  bankName          String?
  bankBranch        String?
  bankAccountName   String?
  bankAccountNumber String?

  projectClosingChecklist Json @default("[\"All project tasks completed\",\"Final deliverables uploaded\",\"BAST uploaded\",\"Final report uploaded\",\"All invoices created\",\"Payment status reviewed\",\"Project expenses recorded\",\"Project financial result calculated\",\"Customer documents complete\"]")

  // Quotation PDF branding (spec: PDF must match the company's exact SOP
  // template). logoUrl already exists above. stampImageUrl is the company's
  // official stamp/cap — it is the same on every quotation regardless of who
  // signs. The signature itself is NOT stored here: each User has their own
  // signatureImageUrl + title, and each Quotation picks which user signs it
  // (Quotation.signerId) so PIC/TTD is customizable per document, not fixed.
  stampImageUrl String?

  // App theming (Settings > Tema): themePreset picks a named, pre-designed
  // color palette (see lib/theme-presets.ts — never raw hex from the user,
  // so contrast against tables/badges/status colors stays guaranteed).
  // dashboardBackgroundUrl is an optional photo (e.g. a workshop shot) shown
  // as a hero band behind the "Aktivitas Saya" dashboard header, with a
  // dark-to-transparent gradient over it so text stays readable — null means
  // the dashboard just uses the flat page background like today.
  themePreset            String  @default("navy")
  dashboardBackgroundUrl String?

  updatedAt DateTime @updatedAt
}
